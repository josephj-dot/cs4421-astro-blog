---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

type Props = {
	author: CollectionEntry<'authors'>['data'];
};

const { author } = Astro.props;
---

<aside class="author-bio" aria-labelledby="author-heading">
	<Image class="author-avatar" src={author.avatar} alt={author.avatarAlt} width={96} height={96} />
	<div class="author-details">
		<p class="author-eyebrow">About the author</p>
		<h2 id="author-heading">{author.name}</h2>
		<p>{author.bio}</p>
		<nav aria-label={`${author.name}'s social links`}>
			<ul>
				{author.socialLinks.map((link) => (
					<li><a href={link.url} rel="me">{link.label}</a></li>
				))}
			</ul>
		</nav>
	</div>
</aside>

<style>
	.author-bio {
		display: flex;
		gap: 1.25rem;
		margin-top: 3rem;
		padding-top: 2rem;
		border-top: 1px solid rgb(var(--gray-light));
	}
	.author-avatar {
		flex: 0 0 96px;
		width: 96px;
		height: 96px;
		object-fit: cover;
		border-radius: 50%;
	}
	.author-details {
		flex: 1;
	}
	.author-eyebrow {
		margin: 0;
		color: rgb(var(--gray));
		font-size: 0.75em;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	.author-details h2 {
		margin: 0.15rem 0 0.5rem;
		font-size: 1.5em;
	}
	.author-details p:not(.author-eyebrow) {
		margin: 0 0 0.75rem;
	}
	.author-details ul {
		display: flex;
		gap: 1rem;
		margin: 0;
		padding: 0;
		list-style: none;
		font-size: 0.9em;
	}
	@media (max-width: 480px) {
		.author-bio {
			align-items: flex-start;
			gap: 1rem;
		}
		.author-avatar {
			flex-basis: 72px;
			width: 72px;
			height: 72px;
		}
	}
</style>