---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

export const prerender = true;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Resources | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="resources-page">
			<p class="eyebrow">Useful links</p>
			<h1>Resources</h1>
			<ul class="resource-list">
				<li>
					<a href="https://www.dublingaa.ie/" target="_blank" rel="noreferrer">
						<span>Dublin GAA</span>
						<span class="resource-url">dublingaa.ie</span>
					</a>
				</li>
				<li>
					<a href="https://www.gaa.ie/" target="_blank" rel="noreferrer">
						<span>The GAA</span>
						<span class="resource-url">gaa.ie</span>
					</a>
				</li>
				<li>
					<a href="https://www.skerriesharps.ie/" target="_blank" rel="noreferrer">
						<span>Skerries Harps</span>
						<span class="resource-url">skerriesharps.ie</span>
					</a>
				</li>
			</ul>
		</main>
		<Footer />
	</body>
</html>

<style>
	.resources-page {
		width: min(760px, calc(100% - 2rem));
	}
	.eyebrow {
		margin: 0 0 0.5rem;
		color: #17628e;
		font-size: 0.8rem;
		font-weight: 700;
		text-transform: uppercase;
	}
	.resources-page h1 {
		margin-bottom: 1.5rem;
		color: #003366;
		font-size: 2.5rem;
	}
	.resource-list {
		margin: 0;
		padding: 0;
		list-style: none;
		border-top: 1px solid #d5e0e8;
	}
	.resource-list li {
		border-bottom: 1px solid #d5e0e8;
	}
	.resource-list a {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 1rem 0.25rem;
		color: #003366;
		text-decoration: none;
	}
	.resource-list a:hover span:first-child {
		text-decoration: underline;
	}
	.resource-url {
		color: #596a78;
		font-size: 0.85rem;
	}
	@media (max-width: 480px) {
		.resource-list a {
			align-items: flex-start;
			flex-direction: column;
			gap: 0.2rem;
		}
	}
</style>