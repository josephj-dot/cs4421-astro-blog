{
    "family": "astro-blog",
    "networkMode": "awsvpc",
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "cpu": "256",
    "memory": "512",
    "executionRoleArn": "arn:aws:iam::947317651085:role/ecsTaskExecutionRole",
    "containerDefinitions": [
        {
            "name": "astro-blog",
            "image": "947317651085.dkr.ecr.us-east-1.amazonaws.com/astro-blog:latest",
            "essential": true,
            "portMappings": [
                {
                    "containerPort": 4321,
                    "hostPort": 4321,
                    "protocol": "tcp"
                }
            ]
        }
    ]
}