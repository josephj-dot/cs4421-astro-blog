{
    "family": "astro-blog",
    "networkMode": "awsvpc",
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "cpu": "256",
    "memory": "512",
    "executionRoleArn": "arn:aws:iam::947317651085:role/ecsTaskExecutionRole",
    "containerDefinitions": [
        {
            "name": "astro-blog",
            "image": "947317651085.dkr.ecr.us-east-1.amazonaws.com/astro-blog:latest",
            "portMappings": [
                {
                    "containerPort": 4321,
                    "hostPort": 4321
                }
            ],
            "healthCheck": {
                "command": [
                    "CMD-SHELL",
                    "wget --no-verbose --tries=1 --spider http://127.0.0.1:4321/api/health || exit 1"
                ],
                "interval": 30,
                "timeout": 5,
                "retries": 3,
                "startPeriod": 20
            },
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/astro-blog",
                    "awslogs-region": "us-east-1",
                    "awslogs-stream-prefix": "ecs"
                }
            }
        }
    ]
}